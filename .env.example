# Copia este archivo a .env y pega tus keys aquí (nunca en el chat). .env no se sube a git.
# Las dos son opcionales: sin ellas el estudio funciona con tu voz, sonidos libres y sin imágenes generadas.

# Voz, efectos de sonido y música: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Imágenes puntuales (plano clave, fondo, producto): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modelo de imágenes; cámbialo si tu cuenta tiene uno más nuevo
OPENAI_IMAGE_MODEL=gpt-image-1

# Opcional: ruta a otro modelo de whisper (por defecto el primero de ~/modelos-whisper)
WHISPER_MODEL=

# Opcional: dónde vive el entorno de la voz local (Kokoro). Por defecto ~/.local/share/estudio-video-ia/voz
VOZ_LOCAL=
